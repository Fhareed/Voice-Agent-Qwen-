# ─────────────────────────────────────────────────────────────
#  Voice Agent — environment variables (TEMPLATE)
# ─────────────────────────────────────────────────────────────
#  HOW TO USE:
#    1. Make a copy of this file and name the copy ".env"
#           cp .env.example .env
#    2. Paste your REAL key after the "=" sign inside .env
#    3. Never commit .env — git is already set to ignore it.
#
#  This .env.example file is safe to commit: it holds no real secrets.
# ─────────────────────────────────────────────────────────────

# ElevenLabs text-to-speech API key.
# Get one at https://elevenlabs.io  →  your profile → "API Keys".
ELEVEN_API_KEY=your-elevenlabs-key-here

# Supabase Postgres connection string (used by db.py to talk to the database).
# Supabase dashboard → "Connect" → "Session pooler" → copy the URI, then replace
# [YOUR-PASSWORD] with the database password you saved when creating the project.
DATABASE_URL=postgresql://postgres.PROJECT:[YOUR-PASSWORD]@aws-0-REGION.pooler.supabase.com:5432/postgres

# Supabase Auth / API keys (Project Settings → API Keys). Used for login (Step 4).
# URL, PUBLISHABLE key and JWKS URL are PUBLIC and safe.
# The SECRET key is ADMIN-level (bypasses tenant isolation) — keep it here only,
# never in code, git, or chat.
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
SUPABASE_SECRET_KEY=sb_secret_xxx
SUPABASE_JWKS_URL=https://YOUR-PROJECT.supabase.co/auth/v1/.well-known/jwks.json

# Where each organization's knowledge-base index folder is stored (Step 6).
# Optional — defaults to "tenant_indexes". This is DATA, so keep it out of git.
TENANT_INDEX_DIR=tenant_indexes

# ── Admin console (founder-only dashboard at /app/admin) ───────────
# Comma-separated emails allowed into the admin area (first gate).
ADMIN_EMAILS=you@example.com
# Shared admin password (second gate). When set, reaching the admin area also
# requires signing in with this password at /app/admin/login. Leave BLANK to
# disable the password gate (admin then stays protected by ADMIN_EMAILS only).
ADMIN_PASSWORD=
# Optional: a separate secret used to sign admin session tokens. If blank, the
# password itself is used as the signing key (fine for a single admin).
ADMIN_SESSION_SECRET=

# ── Founding-customer offer ────────────────────────────────────────
# When on, the one-time €249 setup fee is waived at checkout for everyone
# (matches the "founding offer" banner on the pricing page). Turn off when the
# founding period ends. Customers can also enter Stripe promo codes at checkout.
WAIVE_SETUP_FEE=1

# ── Pro fair-use overage (scripts/bill_overage.py, run monthly) ────
# Pro includes this many call-minutes per calendar month; minutes beyond are
# auto-billed at the per-minute rate below (15 = €0.15/min).
PRO_INCLUDED_MINUTES=1000
OVERAGE_CENTS_PER_MIN=15
